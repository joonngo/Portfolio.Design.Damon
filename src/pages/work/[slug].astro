---
import Base from '../../layouts/Base.astro';
import ProjectImage from '../../components/ProjectImage.astro';
import Swatches from '../../components/Swatches.astro';
import T from '../../components/T.astro';
import { load } from '../../lib/load'; import { next, selected, type Project } from '../../lib/projects'; import { href } from '../../lib/url'; import { projectType } from '../../lib/contact';
export async function getStaticPaths() { const all = await load(); return selected(all).map((p) => ({ params: { slug: p.slug }, props: { p, n: next(all, p.slug) } })); }
const { p, n } = Astro.props as { p: Project; n: Project };
const paras = (s?: string) => (s ? s.split(/\n\s*\n/) : []);
const g = p.gallery, mood = g.length >= 6 ? g.slice(0, 3) : [], out = g.length >= 6 ? g.slice(3) : g;
const facts = [['Scope', p.scope], ['Industry', p.industry], ['Role', p.role], ['Year', p.year]].filter((x): x is [string, string] => !!x[1]);
const type = projectType(p.scope), bare = !p.brief && !p.approach && !p.result && !g.length && !p.swatches.length;
---
<Base title={`${p.client}, ${p.scope}`} description={p.brief?.slice(0, 155) ?? `${p.client}: ${p.scope}. Art direction by Damon Ngo.`} ogImage={href(`/og/${p.slug}.png`)} accent={p.swatches[0]?.hex}>
<article class="case">
  <div class="cover band"><div class="hd"><h1 data-rv="text"><T t={p.client} /></h1><dl class="m">{facts.map(([k, v]) => <div><dt class="mute">{k}</dt><dd><T t={v} /></dd></div>)}</dl></div><div class="cov" data-rv="img"><ProjectImage img={p.cover} file={`${p.code}_cover.jpg`} client={p.client} widths={[640, 1200, 2000]} sizes="94vw" eager /></div></div>
  {bare && <p class="band m soon">Case study in progress.</p>}
  {p.brief && <section id="brief" class="band s-brief"><h2 class="lab m">Brief</h2><div class="lead">{paras(p.brief).map((x) => <p><T t={x} /></p>)}</div></section>}
  {(p.approach || mood.length > 0) && <section id="approach" class="band s-app"><div><h2 class="lab m">Approach</h2>{paras(p.approach).map((x) => <p><T t={x} /></p>)}</div>{mood.length > 0 && <div class="mood">{mood.map((x) => <figure data-loose data-toss data-rv="img"><ProjectImage img={x} file="" client={p.client} widths={[400, 800]} sizes="30vw" />{x.caption && <figcaption class="m mute"><T t={x.caption} /></figcaption>}</figure>)}</div>}</section>}
  {(out.length > 0 || p.swatches.length > 0) && <section id="deliverables" class="s-del"><div class="band"><h2 class="lab m">Deliverables</h2>{p.swatches.length > 0 && <Swatches p={p} />}<div class="gal">{out.map((x) => <figure data-loose data-toss data-rv="img"><ProjectImage img={x} file="" client={p.client} sizes="(max-width:700px) 92vw, 45vw" />{x.caption && <figcaption class="m mute"><T t={x.caption} /></figcaption>}</figure>)}</div></div></section>}
  {p.result && <section id="result" class="band s-res"><h2 class="lab m">Result</h2>{paras(p.result).map((x) => <p class="big-r" data-rv="text"><T t={x} /></p>)}</section>}
  {(p.credits?.length ?? 0) > 0 && <section id="credits" class="band s-cred"><h2 class="lab m">Credits</h2><dl class="m">{p.credits!.map((c) => <div><dt class="mute"><T t={c.role} /></dt><dd><T t={c.name} /></dd></div>)}</dl></section>}
  <div id="cta" class="band"><a class="go" href={href(`/${type ? `?project=${type}` : ''}#contact`)} data-project={type}>Start a project like this <span aria-hidden="true">↗</span></a></div>
  <a id="next" class="band" href={href(`/work/${n.slug}`)} data-cur="View"><span class="m mute">Next project</span><span class="nm"><T t={n.client} /></span><span class="m"><T t={n.scope} /></span><span aria-hidden="true">↗</span></a>
</article>
</Base>
