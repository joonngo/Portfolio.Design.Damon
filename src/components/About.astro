---
import { Picture } from 'astro:assets';
import damon from '../assets/damon.jpg';
import T from './T.astro';
const jobs = [['MOVE', 'Media Leader. Electric vehicles, part of Đông Dương Group.', 'Now'], ['Milano Coffee Vietnam', 'Graphic design and media. F&B, coffee.', 'Before'], ['Gong Cha Vietnam', 'Graphic design. F&B, bubble tea.', 'Before']];
---
<section class="band about" id="about" tabindex="-1">
  <div data-rv="img" class="portrait"><Picture src={damon} alt="Damon Ngo, seated, black and white portrait" formats={['avif', 'webp']} widths={[400, 800]} sizes="(max-width:700px) 92vw, 36vw" pictureAttributes={{ class: 'pic' }} /></div>
  <div><h2>I run media at MOVE and take on brand, packaging and campaign work of my own.</h2>
  <p class="bio">Art director in <span lang="vi">Hồ Chí Minh</span>. 5+ years of graphic design and media for F&amp;B and retail, now electric vehicles.</p>
  <table><caption class="m mute">Where I have worked</caption><tbody>{jobs.map(([a, b, c]) => <tr><th scope="row">{a}</th><td><T t={b} /></td><td class="m mute">{c}</td></tr>)}</tbody></table></div>
</section>
