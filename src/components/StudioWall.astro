---
import type { Project } from '../lib/projects';
import { href } from '../lib/url';
import ProjectImage from './ProjectImage.astro';
import T from './T.astro';
const { items, extra } = Astro.props as { items: Project[]; extra?: Project[] };
/* Few, larger pictures: one or two per selected project. */
const onWall = items.slice(0, 8);
const size = (g: any) => { const r = g.src.width / g.src.height, w = Math.round(Math.max(84, Math.min(190, Math.sqrt(15500 * r)))); return { w, ar: `${g.src.width}/${g.src.height}` }; };
const shots = [
  ...onWall.slice(0, 1).flatMap((p) => p.gallery.slice(onWall.length > 1 ? 1 : 0, 2).map((g) => ({ p, img: g }))),
  ...onWall.slice(1).map((p) => ({ p, img: p.cover ?? p.gallery[0] })).filter((x) => x.img),
].slice(0, 5).map(({ p, img }) => ({ p, img: img!, lab: p.code, to: `/work/${p.slug}`, ...size(img) }));
const fact = items.some((p) => p.code === 'MLN' && p.result?.includes('1B+ VND'));
const cover = items[0];
---
<section id="desk" aria-label="Introduction">
  <div id="intro">
    <p class="m avail"><span class="blink"></span>Available for freelance</p>
    <h1>Art direction for brand, packaging and campaigns.</h1>
    <p class="who">Damon Ngo, Media Leader at MOVE. 5+ years in F&amp;B and retail, now electric vehicles.</p>
    <p class="acts"><a class="hire" href={href('/#contact')}>Start a project</a><a class="u" href={href('/#work')}>See the work</a></p>
    <p class="m mute tip"><span class="dragtip">Drag the pieces. Line the blue mark up with the black one.</span></p>
  </div>
  <div id="cells" aria-hidden="true"></div>
  <div id="wall">
    {cover && <a class="frag big" data-lab="Cover" href={href(`/work/${cover.slug}`)} data-cur="Drag" draggable="false"><div class="d"><div class="p">
      <ProjectImage img={cover.cover} file={`${cover.code}_cover.jpg`} client={cover.client} widths={[400, 800, 1200]} sizes="(max-width:900px) 62vw, 540px" eager style={cover.cover ? `aspect-ratio:${cover.cover.src.width}/${cover.cover.src.height}` : undefined} /></div></div></a>}
    {shots.map(({ p, img, lab, to, w, ar }, i) => <a class="frag" data-m={i < 4 ? 1 : 0} data-lab={lab} href={href(to)} data-cur="Drag" draggable="false" style={`--w:${w}px`}><span class="vh">{p.client}</span><div class="d" aria-hidden="true"><div class="p"><ProjectImage img={img} file="" client={p.client} widths={[w, w * 2]} sizes={`${w}px`} class="shot" style={`aspect-ratio:${ar}`} /></div></div></a>)}
    {['currentColor', 'var(--accent)'].map((c, i) => <div class="frag" data-reg={i ? 'b' : 'k'} data-m="0" data-lab="Reg" data-cur="Drag" aria-hidden="true"><div class="d"><div class="p"><svg width="26" height="26" viewBox="0 0 30 30" fill="none" stroke={c} stroke-width="1.2"><circle cx="15" cy="15" r="8"/><path d="M15 0v30M0 15h30"/></svg></div></div></div>)}
    <div class="frag" data-m="1" data-stamp data-lab="Stamp" data-cur="Drag" aria-hidden="true"><div class="d"><div class="p"><div class="stamp" lang="vi">DUYỆT IN<div class="m">approved</div></div></div></div></div>
    {fact && <div class="frag" data-m="0" data-lab="Result" data-cur="Drag" aria-hidden="true"><div class="d"><div class="p"><div class="fact m"><b>1B+ VND</b>Milano, holiday season</div></div></div></div>}
  </div>
</section>
<script>import '../scripts/wall';</script>
