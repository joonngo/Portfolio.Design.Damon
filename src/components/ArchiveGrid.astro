---
import type { Project } from '../lib/projects';
import T from './T.astro';
import ProjectImage from './ProjectImage.astro';
const { items } = Astro.props as { items: Project[] };
---
{items.length > 0 && <section class="band arch" id="archive" tabindex="-1"><h2>More work</h2><ul>{items.map((p) => { const Tag = p.link ? 'a' : 'div'; return <li><Tag href={p.link} data-cur={p.link ? 'View' : undefined}><ProjectImage img={p.cover} file={`${p.code}_cover.jpg`} client={p.client} widths={[320, 640]} sizes="(max-width:700px) 46vw, 23vw" /><span class="m"><T t={p.client} /><br /><span class="mute"><T t={p.scope} /></span></span></Tag></li>; })}</ul></section>}
