---
import type { Project } from '../lib/projects';
import { href } from '../lib/url';
import T from './T.astro';
import ProjectImage from './ProjectImage.astro';
const { items } = Astro.props as { items: Project[] };
const tags = ['Brand', 'Packaging', 'Campaign'].filter((t) => items.some((p) => p.tags.includes(t)));
---
<div class="filter" role="group" aria-label="Filter work">{['All', ...tags].map((t, i) => <button type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-f={t}>{t}</button>)}</div>
<div class="projs">{items.map((p, i) => <article class="proj" data-tags={p.tags.join(' ')}>
  <a class="row" href={href(`/work/${p.slug}`)} data-cur="View">
    <span class:list={["face", p.cover && p.cover.src.height > p.cover.src.width && "tall"]} data-rv="img"><ProjectImage img={p.cover} file={`${p.code}_cover.jpg`} client={p.client} widths={[480, 960, 1600]} sizes={i === 0 ? '94vw' : '(max-width:700px) 92vw, 46vw'} /></span>
    <span class="tx"><span class="c"><T t={p.client} /></span><span class="c3 m mute"><T t={p.tags.length ? p.tags.join(', ') : p.scope} /></span><span class="ar" aria-hidden="true">↗</span></span>
    {p.brief && <span class="br"><T t={p.brief} /></span>}
  </a></article>)}</div>
<script>import '../scripts/work';</script>
