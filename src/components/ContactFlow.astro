---
import { site } from '../lib/site';
const steps = [
  { key: 'project', q: 'What are we making?', o: ['Brand', 'Packaging', 'Campaign', 'Other'] },
  { key: 'budget', q: 'Rough budget?', o: ['Under 20M VND', '20–50M VND', 'Over 50M VND', 'Not sure yet'] },
  { key: 'timeline', q: 'When do you need it?', o: ['Under 1 month', '1–3 months', 'Flexible'] },
];
---
<noscript><style is:inline>#flow{display:none}</style></noscript>
<div id="flow" data-endpoint={import.meta.env.PUBLIC_FORM_ENDPOINT || site.formEndpoint} data-to={site.email}>
  <ol id="log" class="m" aria-label="Your answers"></ol>
  <form novalidate>
    {steps.map((s, i) => <fieldset data-step={s.key} hidden={i > 0}><legend tabindex="-1">{s.q}</legend><div class="opts">{s.o.map((o) => <button type="button" aria-pressed="false" value={o}>{o}</button>)}</div></fieldset>)}
    <fieldset data-step="final" hidden><legend tabindex="-1">Last one. Tell me about it.</legend>
      <label>Message<textarea name="message" rows="4" aria-describedby="e-message"></textarea></label><p class="err m" id="e-message"></p>
      <div class="two"><div><label>Name<input name="name" autocomplete="name" aria-describedby="e-name"></label><p class="err m" id="e-name"></p></div><div><label>Email<input name="email" type="email" autocomplete="email" aria-describedby="e-email"></label><p class="err m" id="e-email"></p></div></div>
      <p class="m mute why">I only use this to reply to you.</p>
      <input class="pot" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true"><button type="submit" class="send">Send</button></fieldset>
    <button type="button" class="back m" hidden>Back</button>
  </form>
  <div id="status" aria-live="polite"></div>
</div>
<script>import '../scripts/contact';</script>
